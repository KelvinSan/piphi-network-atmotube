{
  "behaviorSchemaVersion": "integration.behaviors.v2",
  "devices": [
    {
      "id": "atmotube_pro",
      "name": "Atmotube Pro",
      "description": "Portable BLE air-quality monitor with VOC, particulate, comfort, pressure, and battery readings.",
      "deviceClass": "air_quality_sensor",
      "entityType": "sensor",
      "capabilities": [
        "voc_ppb",
        "voc_ppm",
        "temperature_c",
        "humidity_percent",
        "pressure_mbar",
        "battery_percent",
        "pm1_ugm3",
        "pm25_ugm3",
        "pm4_ugm3",
        "pm10_ugm3"
      ],
      "intents": [
        {
          "id": "monitor_air_quality",
          "label": "Monitor air quality",
          "description": "React to VOC, particulate, comfort, pressure, and battery changes."
        }
      ],
      "triggers": [
        {
          "id": "state_changed",
          "label": "Air reading changes",
          "description": "Start when Core records changed Atmotube capabilities.",
          "capability": "telemetry.state",
          "runtime": {
            "event": "device.state_changed",
            "source": "integration"
          },
          "freshness": {
            "maxAgeSeconds": 180,
            "staleDataMode": "block"
          },
          "ui": {
            "group": "when"
          }
        }
      ],
      "conditions": [
        {
          "id": "voc_threshold",
          "label": "VOC threshold",
          "type": "number",
          "capability": "sensor.voc_ppb",
          "operators": [">", ">=", "<", "<=", "eq"],
          "runtime": {"source": "state", "field": "voc_ppb", "operator": ">"},
          "ui": {"group": "only_if"}
        },
        {
          "id": "pm25_threshold",
          "label": "PM2.5 threshold",
          "type": "number",
          "capability": "sensor.pm25_ugm3",
          "operators": [">", ">=", "<", "<=", "eq"],
          "runtime": {"source": "state", "field": "pm25_ugm3", "operator": ">"},
          "ui": {"group": "only_if"}
        },
        {
          "id": "pm10_threshold",
          "label": "PM10 threshold",
          "type": "number",
          "capability": "sensor.pm10_ugm3",
          "operators": [">", ">=", "<", "<=", "eq"],
          "runtime": {"source": "state", "field": "pm10_ugm3", "operator": ">"},
          "ui": {"group": "only_if"}
        },
        {
          "id": "temperature_threshold",
          "label": "Temperature threshold",
          "type": "number",
          "capability": "sensor.temperature_c",
          "operators": [">", ">=", "<", "<=", "eq"],
          "runtime": {"source": "state", "field": "temperature_c", "operator": ">"},
          "ui": {"group": "only_if"}
        },
        {
          "id": "humidity_threshold",
          "label": "Humidity threshold",
          "type": "number",
          "capability": "sensor.humidity_percent",
          "operators": [">", ">=", "<", "<=", "eq"],
          "runtime": {"source": "state", "field": "humidity_percent", "operator": ">"},
          "ui": {"group": "only_if"}
        },
        {
          "id": "battery_below",
          "label": "Battery below threshold",
          "type": "number",
          "capability": "sensor.battery_percent",
          "operators": [">", ">=", "<", "<=", "eq"],
          "runtime": {"source": "state", "field": "battery_percent", "operator": "<"},
          "ui": {"group": "only_if"}
        }
      ],
      "freshness": {
        "maxAgeSeconds": 180,
        "staleDataMode": "block"
      },
      "ui": {
        "icon": "wind",
        "category": "air_quality_sensor"
      }
    }
  ],
  "templates": [],
  "telemetry": {
    "capabilityMappings": [
      {"nativeMetric": "voc_ppb", "capability": "sensor.voc_ppb"},
      {"nativeMetric": "voc_ppm", "capability": "sensor.voc_ppm"},
      {"nativeMetric": "temperature_c", "capability": "sensor.temperature_c"},
      {"nativeMetric": "humidity_percent", "capability": "sensor.humidity_percent"},
      {"nativeMetric": "pressure_mbar", "capability": "sensor.pressure_mbar"},
      {"nativeMetric": "battery_percent", "capability": "sensor.battery_percent"},
      {"nativeMetric": "pm1_ugm3", "capability": "sensor.pm1_ugm3"},
      {"nativeMetric": "pm25_ugm3", "capability": "sensor.pm25_ugm3"},
      {"nativeMetric": "pm4_ugm3", "capability": "sensor.pm4_ugm3"},
      {"nativeMetric": "pm10_ugm3", "capability": "sensor.pm10_ugm3"}
    ]
  }
}
